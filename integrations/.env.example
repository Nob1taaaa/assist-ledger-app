# Copy to the study repository root as `.env` (never commit real values).
# Used by the Python RAG app and Cursor hooks — not by the Vite dashboard.

ASSIST_LEDGER_FUNCTION_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/record-model-usage
ASSIST_LEDGER_INGEST_KEY=replace-with-edge-function-ingest-key
ASSIST_LEDGER_REPOSITORY=owner/your-study-repo
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional: attach Ollama runs to a specific PR number for benchmark linking
# ASSIST_LEDGER_PULL_REQUEST_NUMBER=123
